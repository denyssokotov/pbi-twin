<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Enum members such as Int64 or String deliberately mirror TOM and DAX type names. -->
    <NoWarn>$(NoWarn);CA1720</NoWarn>

    <!-- Reproducible builds: anyone can rebuild and compare. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>

    <!-- Pinned dependencies: versions live in Directory.Packages.props, resolved graph in packages.lock.json. -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- The release is published for win-x64; recording it keeps lock files identical for build and publish. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Same analyzer package for build and single-file publish, so both restore the same graph. -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>

    <Authors>PbiTwin contributors</Authors>
    <Copyright>Copyright (c) 2026 PbiTwin contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
