table DimDate
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

	column MonthNumber
		dataType: int64
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [MonthNumber]

	column Month
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: MonthNumber

	column YearMonth
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [YearMonth]

	partition DimDate = calculated
		mode: import
		source =
				VAR FirstYear = YEAR(MIN(FactSales[OrderDate]))
				VAR LastYear = YEAR(MAX(FactSales[ShipDate]))
				RETURN
				    ADDCOLUMNS(
				        CALENDAR(DATE(FirstYear, 1, 1), DATE(LastYear, 12, 31)),
				        "Year", YEAR([Date]),
				        "MonthNumber", MONTH([Date]),
				        "Month", FORMAT([Date], "MMM"),
				        "YearMonth", FORMAT([Date], "YYYY-MM")
				    )

