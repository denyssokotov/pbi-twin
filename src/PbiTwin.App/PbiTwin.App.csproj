<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>PbiTwin.App</RootNamespace>
    <AssemblyName>PbiTwin</AssemblyName>
    <!-- Lets the project compile on non-Windows CI/dev machines; it only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PbiTwin.Core\PbiTwin.Core.csproj" />
  </ItemGroup>

</Project>
