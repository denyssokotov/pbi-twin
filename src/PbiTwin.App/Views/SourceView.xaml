<UserControl x:Class="PbiTwin.App.Views.SourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" Text="Source" />
            <TextBlock Style="{StaticResource Lead}"
                       Text="Open your report (.pbip) in Power BI Desktop. PbiTwin reads its data from Desktop on this computer (localhost only) and its definition from the project folder." />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Style="{StaticResource Label}" Text="2. Project folder (.pbip) of the same report" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowsePbipCommand}" Margin="8,0,0,0" />
                <TextBox Text="{Binding PbipPath, Mode=OneWay}" IsReadOnly="True" />
            </DockPanel>
            <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="6" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <TextBlock Text="{Binding MatchStatus}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMatched}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Good}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </StackPanel>

        <DockPanel Margin="0,0,0,8">
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshInstancesCommand}" />
                <TextBlock Style="{StaticResource Label}" Text="1. Running Power BI Desktop models" Margin="0,0,0,6" VerticalAlignment="Center" />
            </DockPanel>
            <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" BorderBrush="{StaticResource Line}" MinHeight="120">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,6">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DockPanel>
</UserControl>
