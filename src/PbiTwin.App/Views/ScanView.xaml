<UserControl x:Class="PbiTwin.App.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" Text="Scan" />
            <TextBlock Style="{StaticResource Lead}"
                       Text="Every column got a rule from simple heuristics. Check them and change any that are wrong. Columns with 🔗 share one mapping (e.g. a key in a dimension and in its fact tables), so a change applies to all of them; click 🔗 to give a column its own mapping. Highlighted rows are low-confidence guesses." />
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Load rules…" Command="{Binding LoadRulesCommand}" Margin="8,0,0,0"
                        ToolTip="Apply rules saved from an earlier run on this model" />
                <Button DockPanel.Dock="Right" Content="Save rules…" Command="{Binding SaveRulesCommand}" Margin="8,0,0,0"
                        ToolTip="Save the rules (column names and rules only, no data) for the next run" />
                <TextBox DockPanel.Dock="Left" Width="240" Text="{Binding ColumnFilter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter by table, column, detected class or rule" />
                <TextBlock Text="{Binding ScanSummary}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </DockPanel>
            <TextBlock Text="{Binding RulesStatus}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding ColumnsView}" AutoGenerateColumns="False" IsReadOnly="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <!-- Low-confidence guesses deserve a second look. -->
                        <DataTrigger Binding="{Binding IsLowConfidence}" Value="True">
                            <Setter Property="Background" Value="#FFFAEB" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Table" Binding="{Binding Table}" IsReadOnly="True" Width="130" />
                <DataGridTextColumn Header="Column" Binding="{Binding Column}" IsReadOnly="True" Width="150" />
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" IsReadOnly="True" Width="75" />
                <DataGridTemplateColumn Header="Detected as" Width="140" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Reason}">
                                <TextBlock Text="{Binding Detected}" />
                                <TextBlock Text="{Binding Confidence, StringFormat=' · {0}'}" Foreground="{StaticResource Muted}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Rule" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding AllowedRules}" SelectedItem="{Binding Rule, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="34" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="🔗" ToolTip="{Binding SharedWith}" Command="{Binding UnlinkCommand}" Padding="2,0"
                                    BorderThickness="0" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsShared, Converter={StaticResource BoolToVisibility}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Example (masked)" Binding="{Binding Example}" IsReadOnly="True" Width="*" Foreground="{StaticResource Muted}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
